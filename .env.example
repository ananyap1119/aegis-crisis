# ── Aegis-Crisis unified .env ──────────────────────────────────────────────
# Copy to .env and fill in your values

# LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Camera / video source
CRISIS_VIDEO_SOURCE=0
CRISIS_LOCATION=demo-site

# YOLO model paths
FIRE_MODEL_PATH=best.pt
PERSON_MODEL_PATH=yolov8n.pt
MODEL_DIR=
FIRE_MODEL_CATALOG=primary:best.pt
ACTIVE_FIRE_MODEL=primary

# YOLO detection thresholds
FIRE_CLASS_ID=0
SMOKE_CLASS_ID=1
FIRE_THRESHOLD=0.75
SMOKE_THRESHOLD=0.60
MOTION_THRESHOLD=0.02
TEMPORAL_WINDOW=5
TEMPORAL_MIN_HITS=3
MIN_BOX_AREA=500
FIRE_MIN_BOX_AREA=250
FIRE_MAX_BOX_AREA=2000
SMOKE_MIN_BOX_AREA=500
SMOKE_MAX_BOX_AREA=15000

# Aegis HMAC watermark
HMAC_SECRET_KEY=AegisSecureWatermarkKey2025

# Unified database
DB_PATH=data/aegis_crisis.db

# Demo / debug flags
DEMO_MODE=false
DEMO_VIDEO_GLOB=videos/*.mp4
SOCIAL_SIGNAL_FIXTURE_FILE=
DEBUG_SAVE_FIRE_FRAMES=false
DEBUG_FRAME_DIR=debug_fire_frames
